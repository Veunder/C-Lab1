[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[advice]
	detachedhead = false
[remote "origin"]
	url = https://github.com/SFML/SFML.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
[branch "2.6.x"]
	remote = origin
	merge = refs/heads/2.6.x
